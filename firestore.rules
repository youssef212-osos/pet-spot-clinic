rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client-side app currently relies on Firestore directly for realtime clinic data.
    // Keep this permissive for the current Spark-only deployment; tighten with Firebase Auth
    // before exposing the database to untrusted users.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
